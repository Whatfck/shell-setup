# ==========================================
# Shell Setup
# ==========================================

# Aliases básicos

alias ll='eza -lah --icons'
alias la='eza -A --icons'
alias l='eza -CF --icons'
alias ls='eza --icons'
alias lt='eza --tree --icons'

# Navegación

alias ..='cd ..'
alias ...='cd ../..'

# Terminal

alias c='clear'

# Git

alias gs='git status'
alias gp='git pull'
alias ga.='git add .'
